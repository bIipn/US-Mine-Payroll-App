{
  "name": "minemuster-dashboard",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "MineMuster's office dashboard: the company's records, roster, payroll and exports in a browser, for supervisors.",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build",
